# Backend API Base URL (Do not add trailing slash)
# For local dev: http://localhost:8000
# For production: https://your-backend-api.onrender.com
VITE_BACKEND_URL="http://localhost:8000"

# Firebase Web App API Key (For Google OAuth popup authentication)
VITE_FIREBASE_API_KEY="your_firebase_web_api_key"

# Razorpay Public Key ID (Safe to expose on client for payment checkout)
VITE_RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
