# Dependencies
node_modules/
*/node_modules/

# Production build outputs
dist/
dist-ssr/
build/
*/dist/
*/build/

# Environment files and credentials
.env
.env.*
.env.local
.env.*.local
*.env
# Always keep .env.example files tracked
!.env.example
!*/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Server Uploads (keep directory structure via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# OS and Editor files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor directories and temporary files
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
