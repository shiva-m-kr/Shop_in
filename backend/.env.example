# Server Configuration
PORT=8000
# Set to 'production' on deployment (enables secure, cross-site auth cookies)
NODE_ENV=development

# MongoDB Database Connection URL
MONGODB_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shopin?retryWrites=true&w=majority"

# JSON Web Token Secret (used for user/admin auth tokens)
JWT_SECRET="your_jwt_secret_key_here"

# Default Admin Account Credentials
ADMIN_EMAIL="admin@shopin.com"
ADMIN_PASSWORD="your_admin_secure_password"

# Cloudinary Configuration (Product Images & Assets)
CLOUDINARY_NAME="your_cloudinary_cloud_name"
CLOUDINARY_APIKEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_SECREAT_KEY="your_razorpay_secret_key"
# Alias supported by codebase:
# RAZORPAY_SECRET_KEY="your_razorpay_secret_key"

# Optional: Allowed CORS Origins for Production Deployment
# FRONTEND_URL="https://your-shopin-frontend.vercel.app"
# ADMIN_URL="https://your-shopin-admin.vercel.app"
